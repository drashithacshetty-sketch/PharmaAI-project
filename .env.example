# MediSmart AI Environment Configuration

# Flask Application Secret Key (generate a secure random string in production)
SECRET_KEY=medismart-ai-insecure-dev-secret-key-change-in-production

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
# Set USE_SQLITE=True for instant zero-configuration local runs (e.g. during viva or grading)
USE_SQLITE=True

# MySQL Configuration (Used when USE_SQLITE=False)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=medismart_db

# Custom Database URI (optional override, e.g. mysql+pymysql://root:password@localhost:3306/medismart_db)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/medismart_db

# Expiry Monitoring Configurable Thresholds (Days)
EXPIRY_CRITICAL_DAYS=7
EXPIRY_SOON_DAYS=30
EXPIRY_WATCH_DAYS=90

# Inventory Reorder Defaults
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_HORIZON_DAYS=30
DEFAULT_SERVICE_LEVEL_Z=1.65

# Machine Learning Paths
MODEL_DIR=ml/saved_models
DATA_PATH=data/synthetic_sales.csv
