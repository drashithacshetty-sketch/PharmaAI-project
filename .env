# MediSmart AI Local Environment Configuration
SECRET_KEY=medismart-super-secret-key-mca-project-2026-v1
FLASK_ENV=development
FLASK_DEBUG=1

# SQLite enabled by default for zero-friction local execution.
# To connect to MySQL (e.g. XAMPP/WAMP), set USE_SQLITE=False and configure your MySQL credentials.
USE_SQLITE=True

# MySQL parameters (active when USE_SQLITE=False)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=medismart_db

# Configurable Expiry Thresholds
EXPIRY_CRITICAL_DAYS=7
EXPIRY_SOON_DAYS=30
EXPIRY_WATCH_DAYS=90

# Inventory Reorder Defaults
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_HORIZON_DAYS=30
DEFAULT_SERVICE_LEVEL_Z=1.65

MODEL_DIR=ml/saved_models
DATA_PATH=data/synthetic_sales.csv
